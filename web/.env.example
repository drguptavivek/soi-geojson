# Basemap API keys. Copy to `.env` and fill in whichever providers you have.
#
#   cp .env.example .env
#
# A basemap whose key is blank is simply not offered in the layer switcher, so
# you only need to set the ones you actually want.
#
# Vite inlines VITE_* variables into the client bundle, so a key set here is
# visible to anyone who loads the page. That is expected for these services:
# restrict the key by HTTP referrer in the provider's dashboard. Never put a
# secret server-side key in this file.

# https://client.stadiamaps.com  -- Alidade / Smooth basemaps
VITE_STADIA_API_KEY=

# https://account.mapbox.com  -- Streets / Satellite styles
VITE_MAPBOX_TOKEN=

# https://carto.com/basemaps/apikey -- the only raster provider publishing a
# true `nolabels` variant. Without a key the tile server returns a 200 that is
# an "API KEY REQUIRED" placeholder image rather than a map, so these layers
# stay hidden until this is set.
VITE_CARTO_API_KEY=
